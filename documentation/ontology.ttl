<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/OutsideTemperature> rdf:type owl:Class ;
                                                                                        rdfs:subClassOf <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/EnvironmentalProperty> ;
                                                                                        rdfs:comment "An environmental property describing outside or ambient temperature, which may influence perceived stress."@en ;
                                                                                        rdfs:label "Outside Temperature"@en .


