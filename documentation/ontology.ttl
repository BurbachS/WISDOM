###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/Subject
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/Subject> rdf:type owl:Class ;
                                                                             rdfs:subClassOf <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                                                                             <https://schema.org/Person> ;
                                                                             rdfs:comment "A study subject represented as a person and as the feature of interest of observations made during a stress experiment."@en ;
                                                                             rdfs:label "Subject"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/TemperatureSensor
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/TemperatureSensor> rdf:type owl:Class ;
                                                                                       rdfs:subClassOf <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/PhysiologicalSensor> ,
                                                                                                       [ rdf:type owl:Restriction ;
                                                                                                         owl:onProperty <http://www.w3.org/ns/sosa/observes> ;
                                                                                                         owl:someValuesFrom <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/SkinTemperature>
                                                                                                       ] ;
                                                                                       rdfs:comment "A physiological sensor used to measure skin or body-surface temperature."@en ;
                                                                                       rdfs:label "Temperature Sensor"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/TimeSeriesObservation
