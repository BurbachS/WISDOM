@prefix : <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress#> .

<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress> rdf:type owl:Ontology ;
                                                                      owl:imports <http://www.w3.org/2006/time> ,
                                                                                  <http://www.w3.org/ns/sosa/> ;
                                                                      rdfs:label "WISDOM-Stress"@en .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/annotatedDuringActivity
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/annotatedDuringActivity> rdf:type owl:ObjectProperty ;
                                                                                             owl:inverseOf <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/isAnnotatedInRecord> ;
                                                                                             rdfs:domain <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/AnnotationRecord> ;
                                                                                             rdfs:range <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/Activity> ;
                                                                                             rdfs:comment "Links an annotation record to the activity or experimental segment that it annotates."@en ;
                                                                                             rdfs:label "annotated during activity"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasActivityObservation
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasActivityObservation> rdf:type owl:ObjectProperty ;
                                                                                            owl:inverseOf <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/observedDuringActivity> ;
                                                                                            rdfs:domain <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/Activity> ;
                                                                                            rdfs:range <http://www.w3.org/ns/sosa/Observation> ;
                                                                                            rdfs:comment "Links an activity or experimental phase to an observation made during that activity."@en ;
                                                                                            rdfs:label "has activity observation"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasAnnotationRecord
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasAnnotationRecord> rdf:type owl:ObjectProperty ;
                                                                                         rdfs:domain <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/PhysiologicalRecord> ;
                                                                                         rdfs:range <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/AnnotationRecord> ;
                                                                                         rdfs:comment "Links a physiological record to its annotation record."@en ;
                                                                                         rdfs:label "has annotation record"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasAssociatedActivity
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasAssociatedActivity> rdf:type owl:ObjectProperty ;
                                                                                           owl:inverseOf <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasAssociatedStressor> ;
                                                                                           rdfs:domain <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/Stressor> ;
                                                                                           rdfs:range <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/Activity> ;
                                                                                           rdfs:comment "Links a stressor to the activity or experimental phase associated with it."@en ;
                                                                                           rdfs:label "has associated activity"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasAssociatedStressor
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasAssociatedStressor> rdf:type owl:ObjectProperty ;
                                                                                           rdfs:subPropertyOf <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasStressCondition> ;
                                                                                           rdfs:domain <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/Activity> ;
                                                                                           rdfs:range <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/Stressor> ;
                                                                                           rdfs:comment "Links a stress-inducing activity or experimental phase to its associated stressor."@en ;
                                                                                           rdfs:label "has associated stressor"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasPhysiologicalRecord
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasPhysiologicalRecord> rdf:type owl:ObjectProperty ;
                                                                                            owl:inverseOf <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/isPhysiologicalRecordOf> ;
                                                                                            rdfs:domain <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/Subject> ;
                                                                                            rdfs:range <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/PhysiologicalRecord> ;
                                                                                            rdfs:comment "Links a study subject to a physiological record containing measurements collected from that subject."@en ;
                                                                                            rdfs:label "has physiological record"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasSignalChannel
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasSignalChannel> rdf:type owl:ObjectProperty ;
                                                                                      owl:inverseOf <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/isSignalChannelOf> ;
                                                                                      rdfs:domain <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/PhysiologicalRecord> ;
                                                                                      rdfs:range <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/SignalChannel> ;
                                                                                      rdfs:comment "Links a physiological record to one of its signal channels."@en ;
                                                                                      rdfs:label "has signal channel"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasSourceChannel
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasSourceChannel> rdf:type owl:ObjectProperty ;
                                                                                      rdfs:domain <http://www.w3.org/ns/sosa/Observation> ;
                                                                                      rdfs:range <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/SignalChannel> ;
                                                                                      rdfs:comment "Links an observation to the signal channel from which it was derived."@en ;
                                                                                      rdfs:label "has source channel"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasSourceRecord
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasSourceRecord> rdf:type owl:ObjectProperty ;
                                                                                     rdfs:domain <http://www.w3.org/ns/sosa/Observation> ;
                                                                                     rdfs:range <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/PhysiologicalRecord> ;
                                                                                     rdfs:comment "Links an observation to the physiological record from which it was derived."@en ;
                                                                                     rdfs:label "has source record"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasStressCondition
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasStressCondition> rdf:type owl:ObjectProperty ;
                                                                                        rdfs:domain <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/Activity> ;
                                                                                        rdfs:range <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/StressCondition> ;
                                                                                        rdfs:comment "Links an activity or experimental phase to the stress condition represented during that phase."@en ;
                                                                                        rdfs:label "has stress condition"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/isAnnotatedInRecord
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/isAnnotatedInRecord> rdf:type owl:ObjectProperty ;
                                                                                         rdfs:domain <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/Activity> ;
                                                                                         rdfs:range <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/AnnotationRecord> ;
                                                                                         rdfs:comment "Links an activity or experimental segment to the annotation record in which it is annotated."@en ;
                                                                                         rdfs:label "is annotated by record"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/isCausedBy
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/isCausedBy> rdf:type owl:ObjectProperty ;
                                                                                rdfs:domain owl:Thing ;
                                                                                rdfs:range <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/Stressor> ;
                                                                                rdfs:comment "Links an entity to a stressor that causes or contributes to it."@en ;
                                                                                rdfs:label "is caused by"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/isPhysiologicalRecordOf
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/isPhysiologicalRecordOf> rdf:type owl:ObjectProperty ;
                                                                                             rdfs:domain <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/PhysiologicalRecord> ;
                                                                                             rdfs:range <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/Subject> ;
                                                                                             rdfs:comment "Links a physiological record to the study subject from whom its measurements were collected."@en ;
                                                                                             rdfs:label "is physiological record of"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/isSignalChannelOf
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/isSignalChannelOf> rdf:type owl:ObjectProperty ;
                                                                                       rdfs:domain <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/SignalChannel> ;
                                                                                       rdfs:range <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/PhysiologicalRecord> ;
                                                                                       rdfs:comment "Links a signal channel to its physiological record."@en ;
                                                                                       rdfs:label "is signal channel of"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/madeAnnotationRecord
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/madeAnnotationRecord> rdf:type owl:ObjectProperty ;
                                                                                          owl:inverseOf <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/wasMadeByObserver> ;
                                                                                          rdfs:domain <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/HumanObserver> ;
                                                                                          rdfs:range <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/AnnotationRecord> ;
                                                                                          rdfs:comment "Links a human observer to an annotation record made by that observer."@en ;
                                                                                          rdfs:label "made annotation record"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/madeByBiomarkerAssay
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/madeByBiomarkerAssay> rdf:type owl:ObjectProperty ;
                                                                                          rdfs:domain <http://www.w3.org/ns/sosa/Observation> ;
                                                                                          rdfs:range <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/BiomarkerAssay> ;
                                                                                          rdfs:comment "Links an observation to the biomarker assay by which it was made."@en ;
                                                                                          rdfs:label "made by biomarker assay"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/madeByObserver
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/madeByObserver> rdf:type owl:ObjectProperty ;
                                                                                    rdfs:domain <http://www.w3.org/ns/sosa/Observation> ;
                                                                                    rdfs:range <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/HumanObserver> ;
                                                                                    rdfs:comment "Links an observation to the human observer by whom it was made."@en ;
                                                                                    rdfs:label "made by observer"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/observedDuringActivity
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/observedDuringActivity> rdf:type owl:ObjectProperty ;
                                                                                            rdfs:domain <http://www.w3.org/ns/sosa/Observation> ;
                                                                                            rdfs:range <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/Activity> ;
                                                                                            rdfs:comment "Links an observation to the activity or experimental phase during which it was made."@en ;
                                                                                            rdfs:label "observed during activity"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/representsObservableProperty
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/representsObservableProperty> rdf:type owl:ObjectProperty ;
                                                                                                  rdfs:domain <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/SignalChannel> ;
                                                                                                  rdfs:range <http://www.w3.org/ns/sosa/ObservableProperty> ;
                                                                                                  rdfs:comment "Links a signal channel to the observable property represented by the channel."@en ;
                                                                                                  rdfs:label "represents observable property"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/usesUnit
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/usesUnit> rdf:type owl:ObjectProperty ;
                                                                              rdfs:domain <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/SignalChannel> ;
                                                                              rdfs:range <http://qudt.org/schema/qudt/Unit> ;
                                                                              rdfs:comment "Links a signal channel to the unit used for the values represented by that channel."@en ;
                                                                              rdfs:label "uses unit"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/wasMadeByObserver
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/wasMadeByObserver> rdf:type owl:ObjectProperty ;
                                                                                       rdfs:domain <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/AnnotationRecord> ;
                                                                                       rdfs:range <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/HumanObserver> ;
                                                                                       rdfs:comment "Links an annotation record to the human observer by whom it was made."@en ;
                                                                                       rdfs:label "was made by observer"@en .


###  http://www.w3.org/ns/sosa/hosts
<http://www.w3.org/ns/sosa/hosts> rdfs:domain <http://www.w3.org/ns/sosa/Platform> ;
                                  rdfs:range <http://www.w3.org/ns/sosa/Sensor> .


###  http://www.w3.org/ns/sosa/isHostedBy
<http://www.w3.org/ns/sosa/isHostedBy> rdfs:domain <http://www.w3.org/ns/sosa/Sensor> ;
                                       rdfs:range <http://www.w3.org/ns/sosa/Platform> .


###  http://www.w3.org/ns/sosa/isObservedBy
<http://www.w3.org/ns/sosa/isObservedBy> rdfs:domain <http://www.w3.org/ns/sosa/ObservableProperty> ;
                                         rdfs:range <http://www.w3.org/ns/sosa/Sensor> .


###  http://www.w3.org/ns/sosa/madeBySensor
<http://www.w3.org/ns/sosa/madeBySensor> rdfs:domain <http://www.w3.org/ns/sosa/Observation> ;
                                         rdfs:range <http://www.w3.org/ns/sosa/Sensor> .


###  http://www.w3.org/ns/sosa/madeObservation
<http://www.w3.org/ns/sosa/madeObservation> rdfs:domain <http://www.w3.org/ns/sosa/Sensor> ;
                                            rdfs:range <http://www.w3.org/ns/sosa/Observation> .


###  http://www.w3.org/ns/sosa/observes
<http://www.w3.org/ns/sosa/observes> rdfs:domain <http://www.w3.org/ns/sosa/Sensor> ;
                                     rdfs:range <http://www.w3.org/ns/sosa/ObservableProperty> .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/age
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/age> rdf:type owl:DatatypeProperty ;
                                                                         rdfs:domain <https://schema.org/Person> ;
                                                                         rdfs:range xsd:int .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasAnnotationTimeStamp
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasAnnotationTimeStamp> rdf:type owl:DatatypeProperty ;
                                                                                            rdfs:domain <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/AnnotationRecord> ;
                                                                                            rdfs:range xsd:dateTimeStamp ;
                                                                                            rdfs:comment "Timestamp associated with an Annotation Record made by a Human Observer during a stress experiment" ;
                                                                                            rdfs:label "has annotation time stamp" .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasAssayTimeStamp
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasAssayTimeStamp> rdf:type owl:DatatypeProperty ;
                                                                                       rdfs:domain <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/BiomarkerAssay> ;
                                                                                       rdfs:range xsd:dateTimeStamp ;
                                                                                       rdfs:comment "Timestamp indicating when a biomarker assay was performed or recorded." ;
                                                                                       rdfs:label "has assay time stamp" .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasChannelName
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasChannelName> rdf:type owl:DatatypeProperty ;
                                                                                    rdfs:domain <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/SignalChannel> ;
                                                                                    rdfs:range xsd:string ;
                                                                                    rdfs:comment "Name of a signal channel."@en ;
                                                                                    rdfs:label "has channel name"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasDescription
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasDescription> rdf:type owl:DatatypeProperty ;
                                                                                    rdfs:domain <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/Activity> ;
                                                                                    rdfs:range xsd:string ;
                                                                                    rdfs:label "has Description"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasFileFormat
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasFileFormat> rdf:type owl:DatatypeProperty ;
                                                                                   rdfs:domain <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/PhysiologicalRecord> ;
                                                                                   rdfs:range xsd:string ;
                                                                                   rdfs:label "has file format"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasFileName
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasFileName> rdf:type owl:DatatypeProperty ;
                                                                                 rdfs:domain <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/PhysiologicalRecord> ;
                                                                                 rdfs:range xsd:string ;
                                                                                 rdfs:label "has file name"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasIntensity
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasIntensity> rdf:type owl:DatatypeProperty ;
                                                                                  rdfs:domain <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/Activity> ;
                                                                                  rdfs:range xsd:string ;
                                                                                  rdfs:comment "Qualitative intensity of an activity or experimental phase, for example low, moderate, or high."@en ;
                                                                                  rdfs:label "has intensity"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasNote
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasNote> rdf:type owl:DatatypeProperty ;
                                                                             rdfs:domain <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/AnnotationRecord> ;
                                                                             rdfs:range xsd:string ;
                                                                             rdfs:comment "A note associated with an annotation record made by a human observer during a stress experiment."@en ;
                                                                             rdfs:label "has note"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasNumberOfChannels
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasNumberOfChannels> rdf:type owl:DatatypeProperty ;
                                                                                         rdfs:domain <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/PhysiologicalRecord> ;
                                                                                         rdfs:range xsd:integer ;
                                                                                         rdfs:comment "Number of signal channels in a physiological record."@en ;
                                                                                         rdfs:label "has number of channels"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasNumberOfSamples
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasNumberOfSamples> rdf:type owl:DatatypeProperty ;
                                                                                        rdfs:domain <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/PhysiologicalRecord> ;
                                                                                        rdfs:range xsd:integer ;
                                                                                        rdfs:comment "Number of samples in a physiological record."@en ;
                                                                                        rdfs:label "has number of samples"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasReference
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasReference> rdf:type owl:DatatypeProperty ;
                                                                                  rdfs:domain <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/Activity> ;
                                                                                  rdfs:range xsd:anyURI ;
                                                                                  rdfs:label "has Reference"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasSamplingFrequency
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/hasSamplingFrequency> rdf:type owl:DatatypeProperty ;
                                                                                          rdfs:domain <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/SignalChannel> ;
                                                                                          rdfs:range xsd:decimal ;
                                                                                          rdfs:comment "Sampling frequency of a signal channel."@en ;
                                                                                          rdfs:label "has sampling frequency"@en .


###  http://www.w3.org/ns/sosa/resultTime
<http://www.w3.org/ns/sosa/resultTime> rdf:type owl:DatatypeProperty ;
                                       rdfs:domain <http://www.w3.org/ns/sosa/Observation> ;
                                       rdfs:range xsd:dateTime ;
                                       rdfs:comment "The instant of time when an observation was completed and its result became available."@en ;
                                       rdfs:label "result time"@en .


#################################################################
#    Classes
#################################################################

###  http://qudt.org/schema/qudt/Unit
<http://qudt.org/schema/qudt/Unit> rdf:type owl:Class .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/AccelerationX
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/AccelerationX> rdf:type owl:Class ;
                                                                                   rdfs:subClassOf <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/PhysiologicalProperty> ;
                                                                                   rdfs:comment "Acceleration along the x-axis as a physiological or movement-related observable property."@en ;
                                                                                   rdfs:label "AccelerationX"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/AccelerationY
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/AccelerationY> rdf:type owl:Class ;
                                                                                   rdfs:subClassOf <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/PhysiologicalProperty> ;
                                                                                   rdfs:comment "Acceleration along the y-axis as a physiological or movement-related observable property."@en ;
                                                                                   rdfs:label "AccelerationY"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/AccelerationZ
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/AccelerationZ> rdf:type owl:Class ;
                                                                                   rdfs:subClassOf <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/PhysiologicalProperty> ;
                                                                                   rdfs:comment "Acceleration along the z-axis as a physiological or movement-related observable property."@en ;
                                                                                   rdfs:label "AccelerationZ"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/Accelerometer
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/Accelerometer> rdf:type owl:Class ;
                                                                                   rdfs:subClassOf <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/MotionSensor> ,
                                                                                                   [ rdf:type owl:Restriction ;
                                                                                                     owl:onProperty <http://www.w3.org/ns/sosa/observes> ;
                                                                                                     owl:someValuesFrom <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/AccelerationX>
                                                                                                   ] ,
                                                                                                   [ rdf:type owl:Restriction ;
                                                                                                     owl:onProperty <http://www.w3.org/ns/sosa/observes> ;
                                                                                                     owl:someValuesFrom <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/AccelerationY>
                                                                                                   ] ,
                                                                                                   [ rdf:type owl:Restriction ;
                                                                                                     owl:onProperty <http://www.w3.org/ns/sosa/observes> ;
                                                                                                     owl:someValuesFrom <http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/AccelerationZ>
                                                                                                   ] ;
                                                                                   rdfs:comment "A three-axis motion sensor used to measure acceleration along the x, y, and z axes."@en ;
                                                                                   rdfs:label "Accelerometer"@en .


###  http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/Activity
<http://www.semanticweb.org/lennart/ontologies/2026/4/WISDOM-Stress/Activity> rdf:type owl:Class ;
                                                                              rdfs:subClassOf [ rdf:type owl:Restriction ;
