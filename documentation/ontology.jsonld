  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Acceleration along the y-axis as a physiological or movement-related observable property."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "AccelerationY"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://burbachs.github.io/WISDOM/wisdom.owl#PhysiologicalProperty"
  } ]
}, {
  "@id" : "https://burbachs.github.io/WISDOM/wisdom.owl#AccelerationZ",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Acceleration along the z-axis as a physiological or movement-related observable property."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "AccelerationZ"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://burbachs.github.io/WISDOM/wisdom.owl#PhysiologicalProperty"
  } ]
}, {
  "@id" : "https://burbachs.github.io/WISDOM/wisdom.owl#Accelerometer",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A three-axis motion sensor used to measure acceleration along the x, y, and z axes."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Accelerometer"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://burbachs.github.io/WISDOM/wisdom.owl#MotionSensor"
  }, {
    "@id" : "_:genid5"
  }, {
    "@id" : "_:genid6"
  }, {
    "@id" : "_:genid7"
  } ]
}, {
  "@id" : "https://burbachs.github.io/WISDOM/wisdom.owl#Activity",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An activity or experimental phase with a temporal extent that can provide context for observations in a stress experiment."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Activity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid8"
  } ]
}, {
  "@id" : "https://burbachs.github.io/WISDOM/wisdom.owl#AcuteStressor",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A stressor that triggers an immediate or short-term physiological or psychological stress response."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Acute Stressor"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://burbachs.github.io/WISDOM/wisdom.owl#Stressor"
  } ]
}, {
  "@id" : "https://burbachs.github.io/WISDOM/wisdom.owl#AnnotationRecord",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A file or record containing annotations for phases in a stress experiment. Its temporal context can be represented using time:hasTime with an OWL-Time instant or interval."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "AnnotationRecord"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  } ]
}, {
  "@id" : "https://burbachs.github.io/WISDOM/wisdom.owl#AudioSensor",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An audio-based sensor that can produce acoustic or speech-related observations in stress experiments."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Audio Sensor"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Sensor"
  } ]
}, {
  "@id" : "https://burbachs.github.io/WISDOM/wisdom.owl#Baseline",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An initial no-stress reference phase that usually occurs before stress-inducing phases."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Baseline"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://burbachs.github.io/WISDOM/wisdom.owl#Activity"
  }, {
    "@id" : "_:genid9"
  } ]
}, {
