}, {
  "@id" : "https://burbachs.github.io/WISDOM/wisdom.owl",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/bibliographicCitation" : [ {
    "@value" : "Lennart Mackert, Simon Burbach, Paul Schreiber, Maria Maleshkova (2026): WISDOM. https://doi.org/10.5281/zenodo.21677141"
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-07-14"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@id" : "_:genid1"
  }, {
    "@id" : "_:genid2"
  }, {
    "@id" : "_:genid3"
  }, {
    "@id" : "_:genid4"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@value" : "WISDOM: A Wearable Integrated Stress Data Ontology Model"
  } ],
  "http://purl.org/ontology/bibo/doi" : [ {
    "@value" : "10.5281/zenodo.21677141"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The WISDOM (Wearable Integrated Stress Data Ontology Model) ontology provides a semantic model for representing stress-related knowledge and physiological data collected from wearable devices. It integrates conceptual descriptions of human stress, stress-inducing stimuli, experimental context, wearable sensors, physiological observables, and their corresponding observations into a machine-interpretable knowledge graph. By building upon established semantic web standards, WISDOM enables the harmonization and integration of heterogeneous stress datasets while preserving contextual information about study protocols, stressors, and sensor measurements. The ontology supports interoperability, data integration, advanced analytics, and reproducible research in wearable-based stress detection."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "WISDOM"
  } ],
  "http://www.w3.org/2002/07/owl#imports" : [ {
    "@id" : "http://qudt.org/3.0.0/schema/qudt"
  }, {
    "@id" : "http://www.w3.org/2006/time"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/"
  }, {
    "@id" : "http://www.w3.org/ns/ssn/"
  } ]
}, {
  "@id" : "https://burbachs.github.io/WISDOM/wisdom.owl#AccelerationX",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Acceleration along the x-axis as a physiological or movement-related observable property."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "AccelerationX"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://burbachs.github.io/WISDOM/wisdom.owl#PhysiologicalProperty"
  } ]
}, {
  "@id" : "https://burbachs.github.io/WISDOM/wisdom.owl#AccelerationY",
