@prefix : <https://burbachs.github.io/WISDOM/wisdom.owl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix schema: <https://schema.org/> .
@prefix wisdom: <https://burbachs.github.io/WISDOM/wisdom.owl#> .
@base <https://burbachs.github.io/WISDOM/wisdom.owl> .

<https://burbachs.github.io/WISDOM/wisdom.owl> rdf:type owl:Ontology ;
                                                owl:imports <http://qudt.org/3.0.0/schema/qudt> ,
                                                            <http://www.w3.org/2006/time> ,
                                                            sosa: ,
                                                            <http://www.w3.org/ns/ssn/> ;
                                                dct:bibliographicCitation "Lennart Mackert, Simon Burbach, Paul Schreiber, Maria Maleshkova (2026): WISDOM. https://doi.org/10.5281/zenodo.21677141" ;
                                                dct:created "2026-07-14"^^xsd:date ;
                                                dct:creator [ rdf:type foaf:Person ;
                                                              foaf:homepage <https://orcid.org/0009-0006-7138-7902> ;
                                                              foaf:mbox <mailto:lennart.mackert@hsu-hh.de> ;
                                                              foaf:name "Lennart Mackert"
                                                            ] ,
                                                            [ rdf:type foaf:Person ;
                                                              foaf:homepage <https://orcid.org/0009-0009-8373-6622> ;
                                                              foaf:mbox <mailto:burbachs@hsu-hh.de> ;
                                                              foaf:name "Simon Burbach"
                                                            ] ,
                                                            [ rdf:type foaf:Person ;
                                                              foaf:homepage <https://orcid.org/0009-0009-5585-2183> ;
                                                              foaf:mbox <mailto:schreibp@hsu-hh.de> ;
                                                              foaf:name "Paul Schreiber"
                                                            ] ,
                                                            [ rdf:type foaf:Person ;
                                                              foaf:homepage <https://orcid.org/0000-0003-3458-4748> ;
                                                              foaf:mbox <mailto:maleshkm@hsu-hh.de> ;
                                                              foaf:name "Maria Maleshkova"
                                                            ] ;
                                                dct:license <https://creativecommons.org/licenses/by/4.0/> ;
                                                dct:title "WISDOM: A Wearable Integrated Stress Data Ontology Model" ;
                                                bibo:doi "10.5281/zenodo.21677141" ;
                                                rdfs:comment "The WISDOM (Wearable Integrated Stress Data Ontology Model) ontology provides a semantic model for representing stress-related knowledge and physiological data collected from wearable devices. It integrates conceptual descriptions of human stress, stress-inducing stimuli, experimental context, wearable sensors, physiological observables, and their corresponding observations into a machine-interpretable knowledge graph. By building upon established semantic web standards, WISDOM enables the harmonization and integration of heterogeneous stress datasets while preserving contextual information about study protocols, stressors, and sensor measurements. The ontology supports interoperability, data integration, advanced analytics, and reproducible research in wearable-based stress detection."@en ;
                                                rdfs:label "WISDOM"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/bibliographicCitation
dct:bibliographicCitation rdf:type owl:AnnotationProperty .


###  http://purl.org/ontology/bibo/doi
bibo:doi rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/homepage
foaf:homepage rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/mbox
foaf:mbox rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.w3.org/ns/sosa/hosts
sosa:hosts rdfs:domain sosa:Platform ;
           rdfs:range sosa:Sensor .


###  http://www.w3.org/ns/sosa/isHostedBy
sosa:isHostedBy rdfs:domain sosa:Sensor ;
                rdfs:range sosa:Platform .


###  http://www.w3.org/ns/sosa/isObservedBy
sosa:isObservedBy rdfs:domain sosa:ObservableProperty ;
                  rdfs:range sosa:Sensor .


###  http://www.w3.org/ns/sosa/madeBySensor
sosa:madeBySensor rdfs:domain sosa:Observation ;
                  rdfs:range sosa:Sensor .


###  http://www.w3.org/ns/sosa/madeObservation
sosa:madeObservation rdfs:domain sosa:Sensor ;
                     rdfs:range sosa:Observation .


###  http://www.w3.org/ns/sosa/observes
sosa:observes rdfs:domain sosa:Sensor ;
              rdfs:range sosa:ObservableProperty .


###  https://burbachs.github.io/WISDOM/wisdom.owl#annotatedDuringActivity
wisdom:annotatedDuringActivity rdf:type owl:ObjectProperty ;
                               owl:inverseOf wisdom:isAnnotatedInRecord ;
                               rdfs:domain wisdom:AnnotationRecord ;
                               rdfs:range wisdom:Activity ;
                               rdfs:comment "Links an annotation record to the activity or experimental segment that it annotates."@en ;
                               rdfs:label "annotated during activity"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#causes
wisdom:causes rdf:type owl:ObjectProperty ;
              owl:inverseOf wisdom:isCausedBy ;
              rdfs:domain wisdom:Stressor ;
              rdfs:range owl:Thing ;
              rdfs:comment "Links a stressor to an entity that it causes or contributes to."@en ;
              rdfs:label "causes"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#hasActivityObservation
wisdom:hasActivityObservation rdf:type owl:ObjectProperty ;
                              owl:inverseOf wisdom:observedDuringActivity ;
                              rdfs:domain wisdom:Activity ;
                              rdfs:range sosa:Observation ;
                              rdfs:comment "Links an activity or experimental phase to an observation made during that activity."@en ;
                              rdfs:label "has activity observation"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#hasAnnotationRecord
wisdom:hasAnnotationRecord rdf:type owl:ObjectProperty ;
                           owl:inverseOf wisdom:isAnnotationRecordOf ;
                           rdfs:domain wisdom:PhysiologicalRecord ;
                           rdfs:range wisdom:AnnotationRecord ;
                           rdfs:comment "Links a physiological record to its annotation record."@en ;
                           rdfs:label "has annotation record"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#hasAssociatedActivity
wisdom:hasAssociatedActivity rdf:type owl:ObjectProperty ;
                             owl:inverseOf wisdom:hasAssociatedStressor ;
                             rdfs:domain wisdom:Stressor ;
                             rdfs:range wisdom:Activity ;
                             rdfs:comment "Links a stressor to the activity or experimental phase associated with it."@en ;
                             rdfs:label "has associated activity"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#hasAssociatedStressor
wisdom:hasAssociatedStressor rdf:type owl:ObjectProperty ;
                             rdfs:domain wisdom:Activity ;
                             rdfs:range wisdom:Stressor ;
                             rdfs:comment "Links a stress-inducing activity or experimental phase to its associated stressor."@en ;
                             rdfs:label "has associated stressor"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#hasPhysiologicalRecord
wisdom:hasPhysiologicalRecord rdf:type owl:ObjectProperty ;
                              owl:inverseOf wisdom:isPhysiologicalRecordOf ;
                              rdfs:domain wisdom:Subject ;
                              rdfs:range wisdom:PhysiologicalRecord ;
                              rdfs:comment "Links a study subject to a physiological record containing measurements collected from that subject."@en ;
                              rdfs:label "has physiological record"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#hasSignalChannel
wisdom:hasSignalChannel rdf:type owl:ObjectProperty ;
                        owl:inverseOf wisdom:isSignalChannelOf ;
                        rdfs:domain wisdom:PhysiologicalRecord ;
                        rdfs:range wisdom:SignalChannel ;
                        rdfs:comment "Links a physiological record to one of its signal channels."@en ;
                        rdfs:label "has signal channel"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#hasSourceChannel
wisdom:hasSourceChannel rdf:type owl:ObjectProperty ;
                        owl:inverseOf wisdom:isSourceChannelOf ;
                        rdfs:domain sosa:Observation ;
                        rdfs:range wisdom:SignalChannel ;
                        rdfs:comment "Links an observation to the signal channel from which it was derived."@en ;
                        rdfs:label "has source channel"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#hasSourceRecord
wisdom:hasSourceRecord rdf:type owl:ObjectProperty ;
                       owl:inverseOf wisdom:isSourceRecordOf ;
                       rdfs:domain sosa:Observation ;
                       rdfs:range wisdom:PhysiologicalRecord ;
                       rdfs:comment "Links an observation to the physiological record from which it was derived."@en ;
                       rdfs:label "has source record"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#hasStressCondition
wisdom:hasStressCondition rdf:type owl:ObjectProperty ;
                          owl:inverseOf wisdom:isStressConditionOf ;
                          rdfs:domain wisdom:Activity ;
                          rdfs:range wisdom:StressCondition ;
                          rdfs:comment "Links an activity or experimental phase to the stress condition represented during that phase."@en ;
                          rdfs:label "has stress condition"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#isAnnotatedInRecord
wisdom:isAnnotatedInRecord rdf:type owl:ObjectProperty ;
                           rdfs:domain wisdom:Activity ;
                           rdfs:range wisdom:AnnotationRecord ;
                           rdfs:comment "Links an activity or experimental segment to the annotation record in which it is annotated."@en ;
                           rdfs:label "is annotated by record"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#isAnnotationRecordOf
wisdom:isAnnotationRecordOf rdf:type owl:ObjectProperty ;
                            rdfs:domain wisdom:AnnotationRecord ;
                            rdfs:range wisdom:PhysiologicalRecord ;
                            rdfs:comment "Links an annotation record to the physiological record it annotates."@en ;
                            rdfs:label "is annotation record of"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#isCausedBy
wisdom:isCausedBy rdf:type owl:ObjectProperty ;
                  rdfs:domain owl:Thing ;
                  rdfs:range wisdom:Stressor ;
                  rdfs:comment "Links an entity to a stressor that causes or contributes to it."@en ;
                  rdfs:label "is caused by"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#isPhysiologicalRecordOf
wisdom:isPhysiologicalRecordOf rdf:type owl:ObjectProperty ;
                               rdfs:domain wisdom:PhysiologicalRecord ;
                               rdfs:range wisdom:Subject ;
                               rdfs:comment "Links a physiological record to the study subject from whom its measurements were collected."@en ;
                               rdfs:label "is physiological record of"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#isRepresentedBySignalChannel
wisdom:isRepresentedBySignalChannel rdf:type owl:ObjectProperty ;
                                    owl:inverseOf wisdom:representsObservableProperty ;
                                    rdfs:domain sosa:ObservableProperty ;
                                    rdfs:range wisdom:SignalChannel ;
                                    rdfs:comment "Links an observable property to a signal channel representing it."@en ;
                                    rdfs:label "is represented by signal channel"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#isSignalChannelOf
wisdom:isSignalChannelOf rdf:type owl:ObjectProperty ;
                         rdfs:domain wisdom:SignalChannel ;
                         rdfs:range wisdom:PhysiologicalRecord ;
                         rdfs:comment "Links a signal channel to its physiological record."@en ;
                         rdfs:label "is signal channel of"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#isSourceChannelOf
wisdom:isSourceChannelOf rdf:type owl:ObjectProperty ;
                         rdfs:domain wisdom:SignalChannel ;
                         rdfs:range sosa:Observation ;
                         rdfs:comment "Links a signal channel to an observation derived from it."@en ;
                         rdfs:label "is source channel of"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#isSourceRecordOf
wisdom:isSourceRecordOf rdf:type owl:ObjectProperty ;
                        rdfs:domain wisdom:PhysiologicalRecord ;
                        rdfs:range sosa:Observation ;
                        rdfs:comment "Links a physiological record to an observation derived from it."@en ;
                        rdfs:label "is source record of"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#isStressConditionOf
wisdom:isStressConditionOf rdf:type owl:ObjectProperty ;
                           rdfs:domain wisdom:StressCondition ;
                           rdfs:range wisdom:Activity ;
                           rdfs:comment "Links a stress condition to an activity or experimental phase in which it is represented."@en ;
                           rdfs:label "is stress condition of"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#madeAnnotationRecord
wisdom:madeAnnotationRecord rdf:type owl:ObjectProperty ;
                            owl:inverseOf wisdom:wasMadeByObserver ;
                            rdfs:domain wisdom:HumanObserver ;
                            rdfs:range wisdom:AnnotationRecord ;
                            rdfs:comment "Links a human observer to an annotation record made by that observer."@en ;
                            rdfs:label "made annotation record"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#madeByBiomarkerAssay
wisdom:madeByBiomarkerAssay rdf:type owl:ObjectProperty ;
                            rdfs:domain sosa:Observation ;
                            rdfs:range wisdom:BiomarkerAssay ;
                            rdfs:comment "Links an observation to the biomarker assay by which it was made."@en ;
                            rdfs:label "made by biomarker assay"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#madeByObserver
wisdom:madeByObserver rdf:type owl:ObjectProperty ;
                      rdfs:domain sosa:Observation ;
                      rdfs:range wisdom:HumanObserver ;
                      rdfs:comment "Links an observation to the human observer by whom it was made."@en ;
                      rdfs:label "made by observer"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#observedDuringActivity
wisdom:observedDuringActivity rdf:type owl:ObjectProperty ;
                              rdfs:domain sosa:Observation ;
                              rdfs:range wisdom:Activity ;
                              rdfs:comment "Links an observation to the activity or experimental phase during which it was made."@en ;
                              rdfs:label "observed during activity"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#representsObservableProperty
wisdom:representsObservableProperty rdf:type owl:ObjectProperty ;
                                    rdfs:domain wisdom:SignalChannel ;
                                    rdfs:range sosa:ObservableProperty ;
                                    rdfs:comment "Links a signal channel to the observable property represented by the channel."@en ;
                                    rdfs:label "represents observable property"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#wasMadeByObserver
wisdom:wasMadeByObserver rdf:type owl:ObjectProperty ;
                         rdfs:domain wisdom:AnnotationRecord ;
                         rdfs:range wisdom:HumanObserver ;
                         rdfs:comment "Links an annotation record to the human observer by whom it was made."@en ;
                         rdfs:label "was made by observer"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.w3.org/ns/sosa/resultTime
sosa:resultTime rdf:type owl:DatatypeProperty ;
                rdfs:domain sosa:Observation ;
                rdfs:range xsd:dateTime ;
                rdfs:comment "The instant of time when an observation was completed and its result became available."@en ;
                rdfs:label "result time"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#ageAtAssessment
wisdom:ageAtAssessment rdf:type owl:DatatypeProperty ;
                       rdfs:domain schema:Person ;
                       rdfs:range xsd:nonNegativeInteger ;
                       rdfs:comment "The age of a person in completed years at the time of measurement."@en ;
                       rdfs:label "age at assessment"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#hasAnnotationTimeStamp
wisdom:hasAnnotationTimeStamp rdf:type owl:DatatypeProperty ;
                              rdfs:domain wisdom:AnnotationRecord ;
                              rdfs:range xsd:dateTimeStamp ;
                              rdfs:comment "Timestamp associated with an Annotation Record made by a Human Observer during a stress experiment"@en ;
                              rdfs:label "has annotation time stamp"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#hasAssayTimeStamp
wisdom:hasAssayTimeStamp rdf:type owl:DatatypeProperty ;
                         rdfs:domain wisdom:BiomarkerAssay ;
                         rdfs:range xsd:dateTimeStamp ;
                         rdfs:comment "Timestamp indicating when a biomarker assay was performed or recorded."@en ;
                         rdfs:label "has assay time stamp"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#hasChannelName
wisdom:hasChannelName rdf:type owl:DatatypeProperty ;
                      rdfs:domain wisdom:SignalChannel ;
                      rdfs:range xsd:string ;
                      rdfs:comment "Name of a signal channel."@en ;
                      rdfs:label "has channel name"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#hasDescription
wisdom:hasDescription rdf:type owl:DatatypeProperty ;
                      rdfs:domain wisdom:Activity ;
                      rdfs:range xsd:string ;
                      rdfs:comment "The description of an activity made by the experimenter observer."@en ;
                      rdfs:label "has description"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#hasFileFormat
wisdom:hasFileFormat rdf:type owl:DatatypeProperty ;
                     rdfs:domain wisdom:PhysiologicalRecord ;
                     rdfs:range xsd:string ;
                     rdfs:comment "The file format of the physiological record."@en ;
                     rdfs:label "has file format"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#hasFileName
wisdom:hasFileName rdf:type owl:DatatypeProperty ;
                   rdfs:domain wisdom:PhysiologicalRecord ;
                   rdfs:range xsd:string ;
                   rdfs:comment "The file name of the physiological record."@en ;
                   rdfs:label "has file name"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#hasIntensity
wisdom:hasIntensity rdf:type owl:DatatypeProperty ;
                    rdfs:domain wisdom:Activity ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Qualitative intensity of an activity or experimental phase, for example low, moderate, or high."@en ;
                    rdfs:label "has intensity"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#hasNote
wisdom:hasNote rdf:type owl:DatatypeProperty ;
               rdfs:domain wisdom:AnnotationRecord ;
               rdfs:range xsd:string ;
               rdfs:comment "A note associated with an annotation record made by a human observer during a stress experiment."@en ;
               rdfs:label "has note"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#hasNumberOfChannels
wisdom:hasNumberOfChannels rdf:type owl:DatatypeProperty ;
                           rdfs:domain wisdom:PhysiologicalRecord ;
                           rdfs:range xsd:integer ;
                           rdfs:comment "Number of signal channels in a physiological record."@en ;
                           rdfs:label "has number of channels"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#hasNumberOfSamples
wisdom:hasNumberOfSamples rdf:type owl:DatatypeProperty ;
                          rdfs:domain wisdom:PhysiologicalRecord ;
                          rdfs:range xsd:integer ;
                          rdfs:comment "Number of samples in a physiological record."@en ;
                          rdfs:label "has number of samples"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#hasReference
wisdom:hasReference rdf:type owl:DatatypeProperty ;
                    rdfs:domain wisdom:Activity ;
                    rdfs:range xsd:anyURI ;
                    rdfs:comment "Describes whether a certain activity is linked to an established concept. For example, an activity could reference to an established sports assessment or psychological stressor such as the Trier Social Stress Test"@en ;
                    rdfs:label "has Reference"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#hasSamplingFrequency
wisdom:hasSamplingFrequency rdf:type owl:DatatypeProperty ;
                            rdfs:domain wisdom:SignalChannel ;
                            rdfs:range xsd:decimal ;
                            rdfs:comment "Sampling frequency of a signal channel."@en ;
                            rdfs:label "has sampling frequency"@en .


#################################################################
#    Classes
#################################################################

###  http://qudt.org/schema/qudt/Unit
qudt:Unit rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/Person
foaf:Person rdf:type owl:Class .


###  https://burbachs.github.io/WISDOM/wisdom.owl#AccelerationX
wisdom:AccelerationX rdf:type owl:Class ;
                     rdfs:subClassOf wisdom:PhysiologicalProperty ;
                     rdfs:comment "Acceleration along the x-axis as a physiological or movement-related observable property."@en ;
                     rdfs:label "AccelerationX"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#AccelerationY
wisdom:AccelerationY rdf:type owl:Class ;
                     rdfs:subClassOf wisdom:PhysiologicalProperty ;
                     rdfs:comment "Acceleration along the y-axis as a physiological or movement-related observable property."@en ;
                     rdfs:label "AccelerationY"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#AccelerationZ
wisdom:AccelerationZ rdf:type owl:Class ;
                     rdfs:subClassOf wisdom:PhysiologicalProperty ;
                     rdfs:comment "Acceleration along the z-axis as a physiological or movement-related observable property."@en ;
                     rdfs:label "AccelerationZ"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#Accelerometer
wisdom:Accelerometer rdf:type owl:Class ;
                     rdfs:subClassOf wisdom:MotionSensor ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty sosa:observes ;
                                       owl:someValuesFrom wisdom:AccelerationX
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty sosa:observes ;
                                       owl:someValuesFrom wisdom:AccelerationY
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty sosa:observes ;
                                       owl:someValuesFrom wisdom:AccelerationZ
                                     ] ;
                     rdfs:comment "A three-axis motion sensor used to measure acceleration along the x, y, and z axes."@en ;
                     rdfs:label "Accelerometer"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#Activity
wisdom:Activity rdf:type owl:Class ;
                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                  owl:onProperty time:hasTime ;
                                  owl:someValuesFrom time:Interval
                                ] ;
                rdfs:comment "An activity or experimental phase with a temporal extent that can provide context for observations in a stress experiment."@en ;
                rdfs:label "Activity"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#AcuteStressor
wisdom:AcuteStressor rdf:type owl:Class ;
                     rdfs:subClassOf wisdom:Stressor ;
                     rdfs:comment "A stressor that triggers an immediate or short-term physiological or psychological stress response."@en ;
                     rdfs:label "Acute Stressor"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#AnnotationRecord
wisdom:AnnotationRecord rdf:type owl:Class ;
                        rdfs:subClassOf owl:Thing ;
                        rdfs:comment "A file or record containing annotations for phases in a stress experiment. Its temporal context can be represented using time:hasTime with an OWL-Time instant or interval."@en ;
                        rdfs:label "AnnotationRecord"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#AudioSensor
wisdom:AudioSensor rdf:type owl:Class ;
                   rdfs:subClassOf sosa:Sensor ;
                   rdfs:comment "An audio-based sensor that can produce acoustic or speech-related observations in stress experiments."@en ;
                   rdfs:label "Audio Sensor"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#Baseline
wisdom:Baseline rdf:type owl:Class ;
                rdfs:subClassOf wisdom:Activity ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty wisdom:hasStressCondition ;
                                  owl:someValuesFrom wisdom:BaselineCondition
                                ] ;
                rdfs:comment "An initial no-stress reference phase that usually occurs before stress-inducing phases."@en ;
                rdfs:label "Baseline"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#BaselineCondition
wisdom:BaselineCondition rdf:type owl:Class ;
                         rdfs:subClassOf wisdom:NoStressCondition ;
                         rdfs:comment "A no-stress condition representing an initial baseline or reference state before stress-inducing phases."@en ;
                         rdfs:label "Baseline Condition"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#BehavioralProperty
wisdom:BehavioralProperty rdf:type owl:Class ;
                          rdfs:subClassOf sosa:ObservableProperty ;
                          rdfs:comment "A property describing observable behavioral characteristics or activities of an individual."@en ;
                          rdfs:label "Behavioral Property"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#BiomarkerAssay
wisdom:BiomarkerAssay rdf:type owl:Class ;
                      rdfs:comment "A biomarker assay, such as a blood sample analysis for cortisol or adrenaline. Its temporal context can be represented using time:hasTime with an OWL-Time instant or interval."@en ;
                      rdfs:label "Biomarker Assay"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#BloodOxygenSaturation
wisdom:BloodOxygenSaturation rdf:type owl:Class ;
                             rdfs:subClassOf wisdom:PhysiologicalProperty ;
                             rdfs:comment "Peripheral oxygen saturation as a physiological observable property."@en ;
                             rdfs:label "BloodOxygenSaturation"@en .


###  https://burbachs.github.io/WISDOM/wisdom.owl#CameraSensor
